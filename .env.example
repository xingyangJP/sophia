# Sophia 設定の雛形
#
#   cp .env.example .env
#
# 編集後は `make restart` で反映される。
# 各項目の意味と効果は docs/TUNING.md を参照。

# --- Ollama サーバ ---
OLLAMA_HOST=127.0.0.1:11434

# Flash Attention。KVキャッシュ量子化の前提条件なので必ず1。
OLLAMA_FLASH_ATTENTION=1

# KVキャッシュの量子化。長いコンテキストのメモリをほぼ半減できる。
# 品質を最優先したい場合のみ f16 に戻す（メモリ倍増）。
OLLAMA_KV_CACHE_TYPE=q8_0

# メモリ16GB級では必ず1。複数モデルが同時に載るとスワップして激遅になる。
# 32GB以上なら 2 以上も検討できる。
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# モデルをメモリに保持する時間。短いと毎回ロードで待たされ、
# 長いとメモリを占有し続ける。1人利用なら30m前後が折衷点。
OLLAMA_KEEP_ALIVE=30m

# --- Open WebUI ---
# 既定の 8080 は他アプリと衝突しやすいため 8081 を既定にしている。
WEBUI_PORT=8081
