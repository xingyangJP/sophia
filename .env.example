# Sophia 設定の雛形
#
#   cp .env.example .env
#
# 編集後は `make restart` で反映される。
# 各項目の意味と効果は docs/TUNING.md を参照。

# --- Ollama サーバ ---
OLLAMA_HOST=127.0.0.1:11434

# Flash Attention。KVキャッシュ量子化の前提条件なので必ず1。
OLLAMA_FLASH_ATTENTION=1

# KVキャッシュの量子化。2026-08-16 の実測にもとづき q8_0 を既定にしている。
# ただし「q8_0 の方が速い」「メモリが半減する」はどちらも実測で否定された。
#   速度: 4,786トークンの入力処理で f16 32.5秒 / q8_0 34.5秒（中央値）。f16 が約6%速い
#   メモリ: 常駐 f16 6.5〜6.6GB / q8_0 6.0〜6.1GB。差は約0.5GBで「半減」ではない
# それでも q8_0 を既定にする理由は、16GB機ではページングの方が影響が大きいため
# （ページングが起きた計測は最大4.9倍遅くなった）。
# メモリに余裕がある機体なら f16 の方が速い。詳細は docs/TUNING.md 第5章。
OLLAMA_KV_CACHE_TYPE=q8_0

# メモリ16GB級では必ず1。複数モデルが同時に載るとスワップして激遅になる。
# 32GB以上なら 2 以上も検討できる。
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# モデルをメモリに保持する時間。短いと毎回ロードで待たされ、
# 長いとメモリを占有し続ける。1人利用なら30m前後が折衷点。
OLLAMA_KEEP_ALIVE=30m

# --- Open WebUI ---
# 既定の 8080 は他アプリと衝突しやすいため 8081 を既定にしている。
WEBUI_PORT=8081

# 設定の権威を .env 側に移す。**これが無いと以下の ENABLE_* は効かない。**
# Open WebUI は設定をDB（config テーブル）に保存し、環境変数は
# 「DBにまだ行が無いキー」にしか適用されない（models/config.py:256）。
# 初回起動後に .env を書き換えても黙って無視される。
# False にすると Config.get がDBを読まなくなり、.env が権威になる。
# 副作用: 管理画面での設定変更が再起動で消える（1人利用なら許容範囲）。
ENABLE_PERSISTENT_CONFIG=False

# 裏で走る追加のLLM呼び出しを止める。
# Open WebUI は送信のたびにタイトル生成・タグ生成などを本体と同じモデルへ投げる。
# 思考モードのモデルでは1回あたり30秒以上かかり、OLLAMA_NUM_PARALLEL=1 のため
# 本体の応答が順番待ちで塞がれる。
# ※減るのは「呼び出し回数」であって、1回あたりのプロンプト長ではない。
ENABLE_TITLE_GENERATION=False
ENABLE_TAGS_GENERATION=False
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_RETRIEVAL_QUERY_GENERATION=False
ENABLE_SEARCH_QUERY_GENERATION=False
ENABLE_AUTOCOMPLETE_GENERATION=False

# --- プロンプト肥大の抑止（docs/TUNING.md 第2章）---
# Open WebUI 0.11.0 は native function calling 用に、ビルトインツール32個の
# JSONスキーマをシステムメッセージへ自動注入する。
# 「こんにちは」の一言が 4,786トークンになる原因の約95%がこれ
# （素の Ollama API へ同じ入力を送ると245トークン）。
# 入力処理は M3/16GB で約140 tok/s なので、4,786トークンは読むだけで32〜35秒かかる。
# 以下の4つはツール定義そのものを減らす（上の ENABLE_*_GENERATION 群では減らない）。
ENABLE_MEMORIES=False      # メモリ系8ツール 約1,040トークン
ENABLE_CALENDAR=False      # カレンダー系4ツール 約844トークン
ENABLE_AUTOMATIONS=False   # 自動化系5ツール 約815トークン
ENABLE_NOTES=False         # ノート系4ツール 約382トークン

# 使わない重量級機能。
# ENABLE_CODE_INTERPRETER はツール定義を1個（約87トークン）減らす。
# ENABLE_WEB_SEARCH は既定が既に False なので削減量は0。明示しているだけ。
ENABLE_WEB_SEARCH=False
ENABLE_CODE_INTERPRETER=False
ENABLE_EVALUATION_ARENA_MODELS=False

# 残り約1,700トークン（time / knowledge / chats / tasks 系＋「# Tools」定型文）には
# 対応する環境変数が存在しない。ここまで消すには Open WebUI の
# Workspace → Models → 対象モデルの Capabilities で「Builtin Tools」を off にする。
# 環境変数だけでは 4,786 → 約1,600トークンが下限。
